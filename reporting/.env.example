# Kopieren nach reporting/.env (nur fuer manuelle/lokale Snapshot-Laeufe -
# der taegliche automatische Lauf nutzt stattdessen das GitHub-Actions-
# Secret CLARITY_API_TOKEN, siehe reporting/README.md).

# Clarity -> Settings -> Data Export -> Generate new API token
# (nur Projekt-Admins koennen Tokens erzeugen).
CLARITY_API_TOKEN=

# GA4-Property-ID (reine Zahl, NICHT die Measurement-ID "G-XXXXXXXXXX"),
# aus GA4 -> Verwaltung -> Property-Details.
GA4_PROPERTY_ID=

# Dienstkonto-Zugangsdaten fuer GA4: entweder komplett als JSON-String hier
# (fuer GitHub-Actions-Secret GA4_SERVICE_ACCOUNT_JSON) ODER lokal als Datei
# unter reporting/secrets/ga4-service-account.json ablegen (wird automatisch
# gefunden, siehe reporting/README.md) - dann bleibt diese Zeile leer.
GA4_SERVICE_ACCOUNT_JSON=
