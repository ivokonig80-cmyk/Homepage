# Kopieren nach .env (wird von dotenvy geladen, .env selbst ist in .gitignore)

# "tripo" (Default, kostenloser Basic-Tier reicht) oder "meshy" (braucht
# bezahlten Account - Free-Plan hat keinen API-Zugang).
AI_PROVIDER=tripo

TRIPO_API_KEY=dein-tripo-api-key
MESHY_API_KEY=dein-meshy-api-key

FRONTEND_ORIGIN=http://localhost:3000
PORT=8080
