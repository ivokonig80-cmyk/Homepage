# Kopieren nach .env (wird von dotenvy geladen, .env selbst ist in .gitignore)

# "tripo" (Default, kostenloser Basic-Tier reicht) oder "meshy" (braucht
# bezahlten Account - Free-Plan hat keinen API-Zugang).
AI_PROVIDER=tripo

TRIPO_API_KEY=dein-tripo-api-key
MESHY_API_KEY=dein-meshy-api-key

FRONTEND_ORIGIN=http://localhost:3000
PORT=8080

# Wohin jedes erfolgreich generierte Modell zur QA gespiegelt wird (GLB +
# JSON-Watertight-Bericht, siehe main.rs::save_for_qa). Default "../test-models"
# passt zum ueblichen lokalen Start aus backend/. Auf Render ohne Persistent
# Disk ueberlebt das keinen Neu-Deploy - nur fuer lokale/manuelle QA gedacht.
# TEST_MODELS_DIR=../test-models
