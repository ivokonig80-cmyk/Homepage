# Kopieren nach .env.local (Next.js lädt das automatisch, Datei ist in .gitignore)

# Microsoft-Clarity-Projekt-ID für Heatmaps/Session-Recordings (siehe
# src/components/analytics/Analytics.tsx). Kostenloser Account auf
# clarity.microsoft.com anlegen, dort ein Projekt für diese Domain
# erstellen -> die Projekt-ID steht im Setup-Code/Tracking-Snippet.
# Ohne diese Variable läuft die Seite normal, es wird nur nichts getrackt
# (auch nicht nach Zustimmung im Cookie-Banner).
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# Google-Analytics(GA4)-Measurement-ID (Format "G-XXXXXXXXXX"), aus dem
# Google-Tag-Installationsscript im GA4-Property-Setup. Gleiches Verhalten
# wie oben: ohne gesetzte Variable läuft die Seite normal, es wird nur
# nichts an Google gemeldet (auch nicht nach Zustimmung im Cookie-Banner).
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Mixpanel-Projekt-Token (Project Settings -> Access Keys -> Project Token,
# öffentlich/client-seitig sicher zu verwenden - nicht zu verwechseln mit
# dem Service-Account-Secret, das nur serverseitig im reporting/-Ordner
# verwendet wird, siehe reporting/.env.example). Gleiches Verhalten wie
# oben: ohne gesetzte Variable passiert nichts.
NEXT_PUBLIC_MIXPANEL_TOKEN=

# Basis-URL des Rust-Backends (siehe backend/) für die Foto-zu-3D-
# Generierung im Konfigurator. Lokal der laufende `cargo run` (Default-Port
# 8080), in Produktion die deployte Render-Service-URL. Ohne diese Variable
# fällt der Client auf http://localhost:8080 zurück.
NEXT_PUBLIC_API_URL=http://localhost:8080
